# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# GEMINI_MODEL: Model alias used for crop explanations, plant disease analysis, and farming assistant.
# Using gemini-3.8-flash (or gemini-2.5-flash as supported).
GEMINI_MODEL="gemini-3.8-flash"

# Firebase Client config (Optional if using JWT/local store fallback)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# MongoDB Atlas Database Configuration (Server-only, do not prefix with VITE_)
MONGODB_URI=""
MONGODB_DB_NAME="agritech"

# Application configuration
APP_NAME="AgriTech"
JWT_SECRET="agritech_dev_jwt_secret_key_change_in_production"
PORT=3000
